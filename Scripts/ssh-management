#!/usr/bin/env bash

# === New Machine Setup ===
# 1. git clone dotfiles + dotfiles-private
# 2. ssh-management --restore
# 3. ssh-keygen -y -f ~/.ssh/id_ed25519 > ~/.ssh/id_ed25519.pub
# 4. sudo nixos-rebuild switch --flake
# 5. Enter passphrase once (agent remembers for the session)
# =========================

SSH_DIR="$HOME/.ssh"
BACKUP_DIR="$HOME/dotfiles-private/ssh"

if [ "$1" == "--backup" ]; then
	echo "Backing up SSH keys..."
	mkdir -p "$BACKUP_DIR"
	cp "$SSH_DIR/id_ed25519" "$BACKUP_DIR/"
	chmod 700 "$BACKUP_DIR"
	chmod 600 "$BACKUP_DIR/id_ed25519"
	echo "✅ Backup done!"

elif [ "$1" == "--restore" ]; then
	echo "Restoring SSH keys..."
	mkdir -p "$SSH_DIR"
	cp "$BACKUP_DIR/id_ed25519" "$SSH_DIR/"
	chmod 700 "$SSH_DIR"
	chmod 600 "$SSH_DIR/id_ed25519"
	echo "✅ Restore done! Run: sudo nixos-rebuild switch --flake"

else
	echo "Usage: ./ssh-management --backup | --restore"
	exit 1
fi
