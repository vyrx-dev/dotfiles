#!/usr/bin/env bash

# Auto-detect VA-API video drivers using universal Linux kernel flags
if grep -q "AMD" /sys/class/drm/card*/device/vendor 2>/dev/null; then
	export LIBVA_DRIVER_NAME=radeonsi
elif grep -q "Intel" /sys/class/drm/card*/device/vendor 2>/dev/null; then
	export LIBVA_DRIVER_NAME=iHD
fi

browser=$(xdg-settings get default-web-browser 2>/dev/null)

case $browser in
brave-browser* | google-chrome* | microsoft-edge* | opera* | vivaldi* | helium-browser* | helium.desktop) ;;
*) browser="brave-browser.desktop" ;;
esac

# Universal search across standard Linux paths and NixOS system environments
for dir in "$HOME/.local/share/applications" "/usr/share/applications" "/run/current-system/sw/share/applications"; do
	if [ -f "$dir/$browser" ]; then
		browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$dir/$browser" | head -1)
		break
	fi
done

# Absolute fallback if system application definitions cannot be located
if [ -z "$browser_exec" ]; then
	browser_exec="brave-browser"
fi

exec setsid "$browser_exec" --app="$1" "${@:2}"
